# 微信扫码登录所需的变量（加到服务器上的 /var/www/.env，不要提交进仓库）
# JWT_SECRET / AUTH_DB 等既有变量保持原样，本文件只列新增项。
# 注意：本仓库 .gitignore 忽略 config/*.env 与 database/*.db，密钥不会进 git。

# ===== 微信开放平台 · 网站应用（扫码登录，方案 A）=====
WECHAT_APPID=wxXXXXXXXXXXXXXXXX
WECHAT_APPSECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 必须与开放平台后台「网站应用 / 授权回调域名」登记的 redirect_uri 完全一致
WECHAT_CALLBACK_URL=https://auth.xianbao.online/api/auth/wechat/callback
# 登录成功后的回跳地址（建议为带 .xianbao.online cookie 域的前端站点）
WECHAT_SUCCESS_REDIRECT=https://www.xianbao.online/

# ===== 下列变量已存在，确认与中心鉴权一致即可 =====
# JWT_SECRET=********
# （AUTH_DB 由 config/database.js 指向 database/auth.db，无需额外配置）
